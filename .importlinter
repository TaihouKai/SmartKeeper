# 由 docs/design.md「系统架构」一节的依赖表生成。改依赖方向先改设计文档。
[importlinter]
root_package = smartkeeper
include_external_packages = True

[importlinter:contract:contracts]
name = contracts 只依赖 无
type = forbidden
source_modules = smartkeeper.contracts
forbidden_modules =
    smartkeeper.eventlog
    smartkeeper.rules
    smartkeeper.world
    smartkeeper.rounds
    smartkeeper.dice
    smartkeeper.mapdata
    smartkeeper.spatial
    smartkeeper.handles
    smartkeeper.memory
    smartkeeper.engine
    smartkeeper.chat
    smartkeeper.llm
    smartkeeper.kp
    smartkeeper.notify
    smartkeeper.web

